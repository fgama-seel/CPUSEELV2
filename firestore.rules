rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /obras/{obraId} {
      allow read, write: if true;
    }

    match /cpus/{cpuId} {
      allow read, write: if true;
    }

    match /bancoInsumos/{insumoId} {
      allow read, write: if true;
    }

    match /userPermissions/{userDocId} {
      allow read, write: if true;
    }

    match /custosIndiretos/{itemId} {
      allow read, write: if true;
    }

    match /pqItems/{itemId} {
      allow read, write: if true;
    }

    match /scheduleTasks/{itemId} {
      allow read, write: if true;
    }

    match /allocationLinks/{itemId} {
      allow read, write: if true;
    }

    match /weeklyProgress/{itemId} {
      allow read, write: if true;
    }

    match /obraPlanningConfig/{itemId} {
      allow read, write: if true;
    }
  }
}
